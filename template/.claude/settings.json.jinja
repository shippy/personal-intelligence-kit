{#- Permission rule paths: "//abs" = filesystem root, "~/" = home, "./" = session cwd (avoided). -#}
{%- macro rule_path(p) -%}{{ '/' ~ p if p.startswith('/') else p }}{%- endmacro -%}
{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(grep:*)",
{#- Only skill scripts that read local data, sync your own sources or write local reports are pre-allowed,
    called by repo-relative path from the vault root. Everything else that goes through `uv run` (ad-hoc
    Python, add_tasks.py, which writes to To Do, paid image generation, one-off migrations) gets the
    normal permission check. #}
      "Bash(uv run .claude/skills/data-sync/sync_all.py:*)",
      "Bash(uv run .claude/skills/cross-source-queries/generate_report.py:*)",
      "Bash(uv run .claude/skills/cross-source-queries/intention_reality_gaps.py:*)",
      "Bash(uv run .claude/skills/cross-source-queries/commitment_accountability.py:*)",
      "Bash(uv run .claude/skills/cross-source-queries/serendipity_convergence.py:*)",
      "Bash(uv run .claude/skills/_lib/activity.py:*)",
{%- if enable_email %}
      "Bash(uv run .claude/skills/email-ingest/ingest.py:*)",
      "Bash(uv run .claude/skills/email-analyzer/query.py:*)",
{%- endif %}
{%- if enable_browser %}
      "Bash(uv run .claude/skills/browser-ingest/ingest.py:*)",
      "Bash(uv run .claude/skills/session-analyzer/analyze.py:*)",
{%- endif %}
{%- if enable_journal %}
      "Bash(uv run .claude/skills/journal-ingest/ingest.py:*)",
{%- endif %}
{%- if enable_tasks %}
      "Bash(uv run .claude/skills/tasks-import/import_tasks.py:*)",
{%- endif %}
{%- if enable_git %}
      "Bash(uv run .claude/skills/git-stats/ingest.py:*)",
{%- endif %}
      "Bash(uv sync:*)",
      "Bash(sqlite3:*)",
      "Bash(terminal-notifier:*)",
      "Bash(notify-send:*)",
      "Bash(mbsync:*)",
      "Bash(notmuch:*)"
    ],
    "deny": [
{#- Edit(...) covers every built-in file-writing tool (Edit, Write, NotebookEdit);
    separate Write/NotebookEdit rules never match and Claude Code warns about them. #}
{%- if notes_app != 'none' %}
      {{ ("Edit(" ~ rule_path(notes_vault_path) ~ "/**)") | tojson }},
{%- endif %}
{#- Anchored to the logic dir, not "./", so the rules hold whatever the session cwd is. #}
{%- set claude_dir = rule_path(vault_path.rstrip('/')) ~ '/.claude' %}
      {{ ("Edit(" ~ claude_dir ~ "/settings.json)") | tojson }},
      {{ ("Edit(" ~ claude_dir ~ "/settings.local.json)") | tojson }},
      {{ ("Edit(" ~ claude_dir ~ "/hooks/**)") | tojson }}
    ]{% if content_root != '.' %},
    "additionalDirectories": [
      {{ (content_root | expanduser) | tojson }}
    ]{% endif %}
  }
}
