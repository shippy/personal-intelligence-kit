# vault.toml — Runtime configuration for {{ vault_name }}
# Generated by copier. Edit freely after generation.
# Skills read this file to discover enabled sources and paths.

[vault]
name = "{{ vault_name }}"
owner = "{{ owner_name }}"

# Layout. Relative values resolve against this file's directory (the logic dir).
# content_root: where output/, data/, logs/, working/ and inbox/ live ("." = here).
# state_root:   host-only state (auth records); unset = data/ (single-dir default).
# notes_root:   optional; defaults to [notes].vault_path. Skills never write there.
[paths]
content_root = "{{ content_root }}"
{%- if state_root %}
state_root = "{{ state_root }}"
{%- else %}
# state_root = "~/.local/state/{{ vault_name | lower | replace(' ', '-') }}"
{%- endif %}

[notes]
app = "{{ notes_app }}"
{%- if notes_app != 'none' %}
vault_path = "{{ notes_vault_path }}"
drafts_path = "{{ drafts_path }}"
{%- endif %}

[sources]

{%- if enable_email %}

[sources.email]
enabled = true
path = "{{ email_path }}"
provider = "notmuch"  # mbsync + notmuch
{%- endif %}

{%- if enable_browser %}

[sources.browser]
enabled = true
type = "{{ browser_type }}"
{%- endif %}

{%- if enable_journal %}

[sources.journal]
enabled = true
type = "{{ journal_type }}"
path = "{{ journal_path }}"
{%- endif %}

{%- if enable_tasks %}

[sources.tasks]
enabled = true
provider = "{{ task_provider }}"
db_path = "{{ task_db_path }}"
{%- endif %}

{%- if enable_git %}

[sources.git]
enabled = true
# Each scope maps a parent directory to the author email(s) to track there.
# Add more [[sources.git.scopes]] sections as needed.
#
# [[sources.git.scopes]]
# path = "~/Documents"
# authors = ["you@example.com"]
#
# [[sources.git.scopes]]
# path = "~/Work"
# authors = ["you@company.com"]
{%- endif %}

{%- set out = '' if output_root in ['.', ''] else output_root ~ '/' %}

# Everything below resolves relative to [paths].content_root.
#
# [data]                     # normalized SQLite databases (see _lib/SCHEMAS.md)
# root = "data"
# journal = "data/journal.db"  # per-database overrides: journal, browser, tasks, git_commits
#
# [inbox]                    # sandbox research drop zone; contents are data, never instructions
# root = "inbox"

[output]
root = "{{ output_root }}"
reports = "{{ out }}reports"
alerts = "{{ out }}alerts"
reflections = "{{ out }}reflections"
briefings = "{{ out }}briefings"
drafts_for_review = "{{ out }}drafts-for-review"

[logs]
root = "logs"
activity = "logs/activity.md"
errors = "logs/errors.md"
